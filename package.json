{
  "name": "inkbox",
  "private": true,
  "version": "0.1.0",
  "description": "墨匣",
  "author": "Inkbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wan-ans/txt2epub.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "typecheck": "vue-tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build:web && electron-builder --win --x64",
    "dist:dir": "npm run build:web && electron-builder --win --x64 --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.1",
    "jszip": "^3.10.2",
    "quill": "^2.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "appId": "xyz.inkbox.txt2epub",
    "productName": "墨匣",
    "compression": "maximum",
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨匣"
    }
  }
}
